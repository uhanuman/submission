# InvenTree API Test Suite — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── InvenTree Instance ────────────────────────────────────────────────────────
# Base URL of the running InvenTree instance (Docker or remote).
# Example: http://localhost:8000
INVENTREE_BASE_URL=http://localhost:8000

# ─── Authentication ────────────────────────────────────────────────────────────
# API token for an admin/write-enabled user.
# Obtain with: POST /api/user/token/  { "username": "...", "password": "..." }
INVENTREE_API_TOKEN=your_inventree_api_token_here

# ─── Optional: Credential-based token retrieval ────────────────────────────────
# Used by the global setup script (if enabled) to fetch a fresh token each run.
INVENTREE_USERNAME=admin
INVENTREE_PASSWORD=inventree_password_here

# ─── Optional: Docker Compose control ─────────────────────────────────────────
# Set to "true" to make the test setup spin up the InvenTree Docker container
# before running tests (requires Docker and docker-compose installed).
INVENTREE_USE_DOCKER=false
INVENTREE_DOCKER_COMPOSE_FILE=./docker/docker-compose.yml
