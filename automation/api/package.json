{
  "name": "inventree-api-tests",
  "version": "1.0.0",
  "description": "Playwright + TypeScript API automation for InvenTree Part CRUD workflows",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:auth": "playwright test --grep @auth",
    "test:ci": "playwright test --reporter=github",
    "token": "node helpers/generate-token.mjs",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
